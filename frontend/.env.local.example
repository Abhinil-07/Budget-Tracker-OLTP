NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side Supabase Service Key (used securely in Next.js API route handlers)
SUPABASE_SERVICE_KEY=

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# LLM Configuration (Switchable by env vars only)
LLM_PROVIDER=gemini              # anthropic | gemini | openai | mock
LLM_MODEL=gemini-1.5-flash        # e.g. gemini-1.5-flash, gpt-4o-mini, claude-3-5-haiku-20241022
LLM_FALLBACK_PROVIDER=            # optional fallback provider
LLM_FALLBACK_MODEL=               # optional fallback model

# Provider API Keys (only configure the ones you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

